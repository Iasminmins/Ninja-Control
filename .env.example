# Copy this file to .env.local. Use the pooled URL for app requests and the
# direct/unpooled URL for schema migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Optional market-context operational tuning (defaults: 20 s stale, 70% coverage).
MARKET_CONTEXT_STALE_AFTER_MS=20000
MARKET_CONTEXT_MINIMUM_COVERAGE_PERCENT=70
# Required in Vercel to authorize the scheduled market-history retention route.
CRON_SECRET=
